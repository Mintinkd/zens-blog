---
import { NAV, SITE } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<nav class="navbar">
  <a href="/" class="nav-logo">{SITE.name}</a>
  <div class="nav-links">
    {NAV.map((item) => (
      <a href={item.href} class={isActive(item.href) ? 'active' : ''}>{item.label}</a>
    ))}
  </div>
  <div class="nav-spacer"></div>
  <div class="nav-right">
    <label class="search-box">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
        <path d="M16 16L20 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <input type="text" placeholder="搜索文章…" aria-label="搜索文章" />
    </label>
    <ThemeToggle />
  </div>
</nav>

<style>
  .search-box svg {
    color: var(--text-ph);
    flex-shrink: 0;
  }
</style>
