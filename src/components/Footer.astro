---
import { SITE, NAV, SOCIAL } from '../data/site';
const year = new Date().getFullYear();
const mail = SOCIAL.find((s) => s.label === '邮箱')?.href ?? 'mailto:';
const github = SOCIAL.find((s) => s.label === 'GitHub')?.href ?? 'https://github.com/';
---
<footer class="footer-top">
  <div class="brand-col">
    <div class="logo">{SITE.name}</div>
    <div class="tag">{SITE.description}</div>
    <div class="social">
      <a href={mail} aria-label="邮箱">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="2"/><path d="M4 7L12 13L20 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a href={github} aria-label="GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2C6.5 2 2 6.6 2 12.2C2 16.7 5 20.5 9 22C9.6 22.1 9.8 21.7 9.8 21.4V19.4C6.7 20.1 6 18 6 18C5.6 16.9 5 16.6 5 16.6C4.2 16 5.1 16.1 5.1 16.1C6 16.2 6.5 17 6.5 17C7.3 18.3 8.7 17.9 9.3 17.6C9.4 17 9.7 16.5 10 16.3C7.4 16.1 4.8 15.1 4.8 11.2C4.8 10 5.3 9 6 8.3C5.9 8 5.4 6.7 6.1 5C6.1 5 7 4.7 9 5.9C9.9 5.6 10.9 5.5 12 5.5C13.1 5.5 14.1 5.6 15 5.9C17 4.7 17.9 5 17.9 5C18.6 6.7 18.1 8 18 8.3C18.7 9 19.2 10 19.2 11.2C19.2 15.1 16.6 16.1 14 16.3C14.4 16.7 14.8 17.5 14.8 18.6V21.4C14.8 21.7 15 22.1 15.6 22C19.5 20.5 22.5 16.7 22.5 12.2C22.5 6.6 18 2 12 2Z" fill="currentColor"/></svg>
      </a>
    </div>
  </div>
  <div class="nav-col">
    <h4>导航</h4>
    {NAV.map((i) => <a href={i.href}>{i.label}</a>)}
  </div>
  <div class="nav-col">
    <h4>更多</h4>
    <a href="/about">关于我</a>
    <a href="/about#subscribe">订阅博客</a>
    <a href="/about#links">友情链接</a>
  </div>
</footer>
<footer class="footer-bottom">
  <div class="copy">© {year} {SITE.name} · 基于 TDesign 设计体系构建</div>
  <div class="social">
    <a href={mail} aria-label="邮箱">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="2"/><path d="M4 7L12 13L20 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    <a href={github} aria-label="GitHub">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2C6.5 2 2 6.6 2 12.2C2 16.7 5 20.5 9 22C9.6 22.1 9.8 21.7 9.8 21.4V19.4C6.7 20.1 6 18 6 18C5.6 16.9 5 16.6 5 16.6C4.2 16 5.1 16.1 5.1 16.1C6 16.2 6.5 17 6.5 17C7.3 18.3 8.7 17.9 9.3 17.6C9.4 17 9.7 16.5 10 16.3C7.4 16.1 4.8 15.1 4.8 11.2C4.8 10 5.3 9 6 8.3C5.9 8 5.4 6.7 6.1 5C6.1 5 7 4.7 9 5.9C9.9 5.6 10.9 5.5 12 5.5C13.1 5.5 14.1 5.6 15 5.9C17 4.7 17.9 5 17.9 5C18.6 6.7 18.1 8 18 8.3C18.7 9 19.2 10 19.2 11.2C19.2 15.1 16.6 16.1 14 16.3C14.4 16.7 14.8 17.5 14.8 18.6V21.4C14.8 21.7 15 22.1 15.6 22C19.5 20.5 22.5 16.7 22.5 12.2C22.5 6.6 18 2 12 2Z" fill="currentColor"/></svg>
    </a>
  </div>
</footer>

<style>
  .social a {
    color: var(--text-3);
    transition: color .15s;
    display: inline-flex;
  }
  .social a:hover { color: var(--brand); }
</style>
