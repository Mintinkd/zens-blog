---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { title, description, category, cover, pubDate, readingTime } = post.data;
const dateStr = pubDate.toISOString().slice(0, 10);
const meta = `${dateStr} · ${readingTime ?? '5 分钟'}`;
---
<a class="post-card" href={`/post/${post.id}`}>
  <div class={`cover cover--${cover}`}></div>
  <div class="card-body">
    <span class="cat-pill">{category}</span>
    <div class="card-title">{title}</div>
    <div class="card-excerpt">{description}</div>
    <div class="card-meta">{meta}</div>
  </div>
</a>
