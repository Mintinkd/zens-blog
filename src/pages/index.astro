---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProfileCard from '../components/ProfileCard.astro';
import TagChip from '../components/TagChip.astro';

const posts = (await getCollection('posts', (e) => !e.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const latest = posts.slice(0, 3);
const tocPosts = posts.slice(0, 3);

const tagCount = new Map<string, number>();
posts.forEach((p) => p.data.tags.forEach((t) => tagCount.set(t, (tagCount.get(t) ?? 0) + 1)));
const hotTags = [...tagCount.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map((e) => e[0]);
---
<BaseLayout>
  <header class="hero">
    <h1>记录前端与设计</h1>
    <p>一个关于代码、设计与思考的个人博客。</p>
    <label class="hero-search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
        <path d="M16 16L20 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <input type="text" placeholder="搜索文章、标签或作者…" aria-label="搜索" />
    </label>
  </header>

  <div class="main-row">
    <div class="posts-col">
      <div class="section-head">
        <h2>最新文章</h2>
        <a class="more" href="/posts">查看全部</a>
      </div>
      <div class="post-grid" style="margin-top:20px">
        {latest.map((p) => <ArticleCard post={p} />)}
      </div>
    </div>

    <aside class="side-col">
      <div class="side-card">
        <h3>目录</h3>
        <nav class="toc">
          {tocPosts.map((p) => <a href={`/post/${p.id}`}>{p.data.title}</a>)}
        </nav>
      </div>
      <ProfileCard />
      <div class="side-card">
        <h3>热门标签</h3>
        <div class="tag-cloud">
          {hotTags.map((t) => <TagChip tag={t} />)}
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .hero-search svg {
    color: var(--text-ph);
    flex-shrink: 0;
  }
</style>
